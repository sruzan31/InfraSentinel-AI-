# InfraSentinel AI Environment Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="InfraSentinel AI"

# Database Configuration (PostgreSQL primary, fallback to SQLite for zero-dep tests)
DATABASE_URL=postgresql://ksruzanroy@localhost:5432/infrasentinel
# Fallback SQLite: DATABASE_URL=sqlite:///./infrasentinel.db

# Security & Authentication
SECRET_KEY=infrasentinel_super_secure_jwt_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Service
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME="InfraSentinel AI"

# Simulator Settings
SIMULATOR_INTERVAL_SECONDS=1.0
DEFAULT_SCENARIO=normal
